<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="@dimen/elevation_card"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardPreventCornerOverlap="false"
        android:stateListAnimator="@null"
        app:contentPadding="@dimen/padding_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Total Calories -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:id="@+id/tvTotalCaloriesLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calorias_totales"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvTotalCaloriesValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kcal_short"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginStart="@dimen/spacing_xs" />
        </LinearLayout>

        <!-- Macro Progress Bars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/spacing_md">

            <!-- Protein -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:id="@+id/vProteinColor"
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@color/macro_protein"
                    android:alpha="0.8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/proteinas_short"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <TextView
                    android:id="@+id/tvProteinValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0g"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbProtein"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/progress_track_thickness"
                    android:layout_weight="1"
                    android:progress="0"
                    app:indicatorColor="@color/macro_protein"
                    app:trackColor="@color/macro_protein_track"
                    app:trackCornerRadius="@dimen/radius_progress_track" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:id="@+id/vCarbsColor"
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@color/macro_carbs"
                    android:alpha="0.8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carbohidratos_short"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <TextView
                    android:id="@+id/tvCarbsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0g"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbCarbs"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/progress_track_thickness"
                    android:layout_weight="1"
                    android:progress="0"
                    app:indicatorColor="@color/macro_carbs"
                    app:trackColor="@color/macro_carbs_track"
                    app:trackCornerRadius="@dimen/radius_progress_track" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/vFatColor"
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@color/macro_fat"
                    android:alpha="0.8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grasas_short"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <TextView
                    android:id="@+id/tvFatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0g"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbFat"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/progress_track_thickness"
                    android:layout_weight="1"
                    android:progress="0"
                    app:indicatorColor="@color/macro_fat"
                    app:trackColor="@color/macro_fat_track"
                    app:trackCornerRadius="@dimen/radius_progress_track" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>