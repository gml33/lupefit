<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         LUPEFIT - TIPOGRAFÍA MATERIAL 3
         Escala: Display > Headline > Title > Body > Label
         Fuente: System default (Roboto/Inter) - se puede cambiar a variable font
         ============================================================ -->
    
    <!-- Display -->
    <style name="TextAppearance.LuPeFit.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">57sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">-0.014</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">45sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">36sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>
    
    <!-- Headline -->
    <style name="TextAppearance.LuPeFit.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <!-- Title -->
    <style name="TextAppearance.LuPeFit.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.009</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <!-- Body -->
    <style name="TextAppearance.LuPeFit.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.003</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.001</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.024</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    
    <!-- Label -->
    <style name="TextAppearance.LuPeFit.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.031</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <style name="TextAppearance.LuPeFit.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.031</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <!-- ============================================================
         LUPEFIT - FORMAS (SHAPES) MATERIAL 3
         Bordes suaves, consistentes
         ============================================================ -->
    
    <!-- 4dp - Chips, botones pequeños, badges -->
    <style name="ShapeAppearance.LuPeFit.CornerExtraSmall" parent="ShapeAppearance.Material3.CornerExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    
    <!-- 8dp - Botones, FAB, TextInput, Chips grandes -->
    <style name="ShapeAppearance.LuPeFit.CornerSmall" parent="ShapeAppearance.Material3.CornerSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    
    <!-- 12dp - Tarjetas, Dialogs, Bottom Sheets, Menús -->
    <style name="ShapeAppearance.LuPeFit.CornerMedium" parent="ShapeAppearance.Material3.CornerMedium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    
    <!-- 16dp - Sheets grandes, modales full-screen -->
    <style name="ShapeAppearance.LuPeFit.CornerLarge" parent="ShapeAppearance.Material3.CornerLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    
    <!-- 28dp - FAB extendido, elementos hero -->
    <style name="ShapeAppearance.LuPeFit.CornerExtraLarge" parent="ShapeAppearance.Material3.CornerExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    
    <!-- ============================================================
         LUPEFIT - COMPONENTES WIDGETS
         ============================================================ -->
    
    <!-- Botones -->
    <style name="Widget.LuPeFit.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">24dp</item>
    </style>
    
    <style name="Widget.LuPeFit.Button.Filled" parent="Widget.Material3.Button.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">24dp</item>
    </style>
    
    <style name="Widget.LuPeFit.Button.Tonal" parent="Widget.Material3.Button.Tonal">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">24dp</item>
    </style>
    
    <style name="Widget.LuPeFit.Button.Outlined" parent="Widget.Material3.Button.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">24dp</item>
    </style>
    
    <style name="Widget.LuPeFit.Button.Text" parent="Widget.Material3.Button.Text">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>
    
    <!-- FAB -->
    <style name="Widget.LuPeFit.FAB" parent="Widget.Material3.FloatingActionButton">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerExtraLarge</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorOnPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
    </style>
    
    <style name="Widget.LuPeFit.FAB.Extended" parent="Widget.Material3.ExtendedFloatingActionButton">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerExtraLarge</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:paddingHorizontal">24dp</item>
    </style>
    
    <!-- TextInputLayout -->
    <style name="Widget.LuPeFit.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
        <item name="boxStrokeColor">@color/text_input_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    
    <!-- Chip -->
    <style name="Widget.LuPeFit.Chip" parent="Widget.Material3.Chip.Entry">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerExtraSmall</item>
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="checkedIconTint">?attr/colorOnPrimary</item>
        <item name="closeIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:minHeight">32dp</item>
    </style>
    
    <style name="Widget.LuPeFit.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerExtraSmall</item>
        <item name="chipBackgroundColor">@color/chip_filter_background_color</item>
        <item name="android:textColor">@color/chip_filter_text_color</item>
        <item name="iconTint">@color/chip_filter_icon_color</item>
    </style>
    
    <style name="Widget.LuPeFit.Chip.Choice" parent="Widget.Material3.Chip.Choice">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerExtraSmall</item>
        <item name="chipBackgroundColor">@color/chip_choice_background_color</item>
        <item name="android:textColor">@color/chip_choice_text_color</item>
    </style>
    
    <!-- Navigation Bar / Bottom Navigation -->
    <style name="Widget.LuPeFit.NavigationBar" parent="Widget.Material3.NavigationBarView">
        <item name="background">?attr/colorSurface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LuPeFit.NavigationBar.ActiveIndicator</item>
        <item name="itemIconTint">@color/nav_item_icon_color</item>
        <item name="itemTextColor">@color/nav_item_text_color</item>
        <item name="itemRippleColor">@color/nav_item_ripple_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    
    <style name="Widget.LuPeFit.NavigationBar.ActiveIndicator">
        <item name="android:background">@drawable/nav_active_indicator</item>
    </style>
    
    <!-- Bottom Sheet -->
    <style name="Widget.LuPeFit.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerLarge</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>
    
    <style name="Widget.LuPeFit.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerLarge</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>
    
    <!-- Dialog -->
    <style name="Widget.LuPeFit.Dialog" parent="Widget.Material3.Dialog">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerMedium</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>
    
    <style name="Widget.LuPeFit.AlertDialog" parent="Widget.Material3.AlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerMedium</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="buttonBarStyle">@style/Widget.LuPeFit.ButtonBar.AlertDialog</item>
    </style>
    
    <style name="Widget.LuPeFit.ButtonBar.AlertDialog" parent="Widget.Material3.ButtonBar.AlertDialog">
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    
    <!-- CardView / MaterialCardView -->
    <style name="Widget.LuPeFit.CardView" parent="Widget.Material3.CardView">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerMedium</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">2dp</item>
        <item name="cardMaxElevation">8dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>
    
    <style name="Widget.LuPeFit.MaterialCardView" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerMedium</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:padding">16dp</item>
    </style>
    
    <style name="Widget.LuPeFit.MaterialCardView.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerMedium</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">4dp</item>
        <item name="android:padding">16dp</item>
    </style>
    
    <!-- Dividers -->
    <style name="Widget.LuPeFit.Divider.Horizontal" parent="Widget.Material3.Divider.Horizontal">
        <item name="android:background">?attr/colorOutlineVariant</item>
        <item name="android:layout_height">1dp</item>
    </style>
    
    <style name="Widget.LuPeFit.Divider.Vertical" parent="Widget.Material3.Divider.Vertical">
        <item name="android:background">?attr/colorOutlineVariant</item>
        <item name="android:layout_width">1dp</item>
    </style>
    
    <!-- Progress Indicators -->
    <style name="Widget.LuPeFit.ProgressBar" parent="Widget.Material3.ProgressBar">
        <item name="indeterminateTint">?attr/colorPrimary</item>
    </style>
    
    <style name="Widget.LuPeFit.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceVariant</item>
        <item name="trackThickness">4dp</item>
    </style>
    
    <style name="Widget.LuPeFit.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceVariant</item>
        <item name="trackThickness">4dp</item>
        <item name="indicatorCornerRadius">2dp</item>
    </style>
    
    <!-- Switch / CheckBox / RadioButton -->
    <style name="Widget.LuPeFit.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_color</item>
        <item name="trackTint">@color/switch_track_color</item>
    </style>
    
    <style name="Widget.LuPeFit.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/checkbox_color</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    
    <style name="Widget.LuPeFit.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/radio_button_color</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    
    <!-- Slider -->
    <style name="Widget.LuPeFit.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">?attr/colorPrimary</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceVariant</item>
        <item name="haloColor">@color/slider_halo_color</item>
        <item name="tickColor">?attr/colorOnSurfaceVariant</item>
        <item name="thumbRadius">12dp</item>
        <item name="trackHeight">4dp</item>
    </style>
    
    <!-- Tooltip -->
    <style name="Widget.LuPeFit.Tooltip" parent="Widget.Material3.Tooltip">
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerExtraSmall</item>
        <item name="backgroundTint">?attr/colorInverseSurface</item>
        <item name="android:textColor">?attr/colorInverseOnSurface</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>
    
    <!-- Snackbar -->
    <style name="Widget.LuPeFit.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorInverseSurface</item>
        <item name="actionTextColor">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorInverseOnSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
    </state>
    
    <!-- Toolbar -->
    <style name="Widget.LuPeFit.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.LuPeFit.TitleMedium</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.LuPeFit.BodySmall</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="menuIconTint">?attr/colorOnSurface</item>
        <item name="background">?attr/colorSurface</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>
</resources>