<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         LUPEFIT - TEMA MODO OSCURO (values-night)
         Hereda de Theme.LuPeFit, los colores vienen de values-night/colors.xml
         ============================================================ -->
    
    <style name="Theme.LuPeFit" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Los colores se toman automáticamente de values-night/colors.xml -->
        <!-- Typography y Shapes igual que en light -->
        
        <!-- Typography - Material 3 Type Scale -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.LuPeFit.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.LuPeFit.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.LuPeFit.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LuPeFit.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.LuPeFit.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.LuPeFit.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.LuPeFit.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LuPeFit.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.LuPeFit.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.LuPeFit.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.LuPeFit.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.LuPeFit.LabelSmall</item>
        
        <!-- Shapes - Material 3 Shape Scale -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.LuPeFit.CornerExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.LuPeFit.CornerSmall</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.LuPeFit.CornerMedium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.LuPeFit.CornerLarge</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.LuPeFit.CornerExtraLarge</item>
        
        <!-- Component Overrides -->
        <item name="materialButtonStyle">@style/Widget.LuPeFit.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.LuPeFit.Button.Outlined</item>
        <item name="materialButtonTextStyle">@style/Widget.LuPeFit.Button.Text</item>
        <item name="filledButtonStyle">@style/Widget.LuPeFit.Button.Filled</item>
        <item name="tonalButtonStyle">@style/Widget.LuPeFit.Button.Tonal</item>
        <item name="outlinedButtonStyle">@style/Widget.LuPeFit.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.LuPeFit.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.LuPeFit.Chip</item>
        <item name="navigationBarStyle">@style/Widget.LuPeFit.NavigationBar</item>
        <item name="bottomSheetStyle">@style/Widget.LuPeFit.BottomSheet</item>
        <item name="dialogStyle">@style/Widget.LuPeFit.Dialog</item>
        <item name="alertDialogStyle">@style/Widget.LuPeFit.AlertDialog</item>
        <item name="floatingActionButtonStyle">@style/Widget.LuPeFit.FAB</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.LuPeFit.FAB.Extended</item>
        <item name="cardViewStyle">@style/Widget.LuPeFit.CardView</item>
        <item name="materialCardViewStyle">@style/Widget.LuPeFit.MaterialCardView</item>
        <item name="dividerHorizontalStyle">@style/Widget.LuPeFit.Divider.Horizontal</item>
        <item name="dividerVerticalStyle">@style/Widget.LuPeFit.Divider.Vertical</item>
        <item name="progressBarStyle">@style/Widget.LuPeFit.ProgressBar</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.LuPeFit.CircularProgressIndicator</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.LuPeFit.LinearProgressIndicator</item>
        <item name="switchStyle">@style/Widget.LuPeFit.Switch</item>
        <item name="checkboxStyle">@style/Widget.LuPeFit.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.LuPeFit.RadioButton</item>
        <item name="sliderStyle">@style/Widget.LuPeFit.Slider</item>
        <item name="tooltipStyle">@style/Widget.LuPeFit.Tooltip</item>
        <item name="snackbarStyle">@style/Widget.LuPeFit.Snackbar</item>
    </style>
    
    <!-- Tema para Splash Screen en modo oscuro -->
    <style name="Theme.LuPeFit.Splash" parent="Theme.LuPeFit">
        <item name="android:windowBackground">@drawable/splash_background_night</item>
        <item name="android:windowSplashScreenBackground">@color/lupefit_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_lupefit_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
    
    <style name="Theme.LuPeFit.Toolbar" parent="Theme.LuPeFit">
        <item name="toolbarStyle">@style/Widget.LuPeFit.Toolbar</item>
    </style>
    
    <style name="Theme.LuPeFit.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LuPeFit.BottomSheet.Modal</item>
    </style>
</resources>