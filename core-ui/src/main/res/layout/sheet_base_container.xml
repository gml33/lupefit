<?xml version="1.0" encoding="utf-8"?>
<!-- sheet_base_container.xml - Estructura estándar para BottomSheetDialogFragment -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="title" type="String" />
        <variable name="actionText" type="String" />
        <variable name="onActionClick" type="android.view.View.OnClickListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <!-- Píldora superior de arrastre (BottomSheetDragHandleView) -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:layout_gravity="center_horizontal"
            app:dragHandleColor="?attr/colorOutline"
            app:dragHandleSize="@dimen/touch_target_min" />

        <!-- Título en 18sp Bold -->
        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_card"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="@{title}"
            android:textAppearance="@style/TextAppearance.LuPeFit.TitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Título del Sheet" />

        <!-- Contenido dinámico (se infla aquí via FragmentTransaction) -->
        <FrameLayout
            android:id="@+id/flSheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_card"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- Botón de acción inferior de ancho completo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_card"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:minHeight="@dimen/touch_target_comfortable"
            android:onClick="@{onActionClick}"
            android:text="@{actionText}"
            android:textAppearance="@style/TextAppearance.LuPeFit.LabelLarge"
            app:cornerRadius="@dimen/radius_pill"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            tools:text="Guardar"
            tools:ignore="MissingConstraints" />

    </LinearLayout>
</layout>