<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.PerfilHomeFragment">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/perfil_title" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionEditarPerfil"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/editar_perfil"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionLogin"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/entrar"
                    app:icon="@drawable/ic_email"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionRegistro"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/registrate"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionSyncAccount"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/sync_account"
                    app:icon="@drawable/ic_sync"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionCambiarPassword"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/cambiar_password"
                    app:icon="@drawable/ic_lock"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
