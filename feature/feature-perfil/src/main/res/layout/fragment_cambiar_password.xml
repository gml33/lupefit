<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="com.lupefit.feature.perfil.R" />
        <variable
            name="viewModel"
            type="com.lupefit.feature.perfil.viewmodel.CambiarPasswordViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.CambiarPasswordFragment">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/cambiar_password" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cambiar_contraseña"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textAlignment="center"
                            android:layout_marginBottom="@dimen/spacing_s" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ingresa_contraseña_actual_y_nueva"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAlignment="center"
                            android:layout_marginBottom="@dimen/spacing_xl" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPasswordActual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_m"
                            android:hint="@string/contraseña_actual"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="@dimen/corner_small"
                            app:boxCornerRadiusTopEnd="@dimen/corner_small"
                            app:boxCornerRadiusBottomStart="@dimen/corner_small"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPasswordActual"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:text="@{viewModel.passwordActual}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPasswordNueva"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_m"
                            android:hint="@string/contraseña_nueva"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="@dimen/corner_small"
                            app:boxCornerRadiusTopEnd="@dimen/corner_small"
                            app:boxCornerRadiusBottomStart="@dimen/corner_small"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPasswordNueva"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:text="@{viewModel.passwordNueva}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilConfirmPasswordNueva"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_m"
                            android:hint="@string/confirmar_contraseña_nueva"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="@dimen/corner_small"
                            app:boxCornerRadiusTopEnd="@dimen/corner_small"
                            app:boxCornerRadiusBottomStart="@dimen/corner_small"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etConfirmPasswordNueva"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:text="@{viewModel.confirmPasswordNueva}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCambiarPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cambiar_contraseña"
                            android:enabled="@{!viewModel.cargando}"
                            app:icon="@drawable/ic_save"
                            app:iconGravity="start" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:visibility="@{viewModel.cargando ? View.VISIBLE : View.GONE}" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
