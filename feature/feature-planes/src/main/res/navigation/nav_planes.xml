<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_planes"
    app:startDestination="@id/planesHomeFragment">

    <fragment
        android:id="@+id/planesHomeFragment"
        android:name="com.lupefit.feature.planes.ui.PlanesHomeFragment"
        android:label="@string/planes_title"
        tools:layout="@layout/fragment_planes_home">
        <action
            android:id="@+id/action_planesHomeFragment_to_planComidaFragment"
            app:destination="@id/planComidaFragment" />
        <action
            android:id="@+id/action_planesHomeFragment_to_planEntrenamientoFragment"
            app:destination="@id/planEntrenamientoFragment" />
        <action
            android:id="@+id/action_planesHomeFragment_to_presupuestoPlanFragment"
            app:destination="@id/presupuestoPlanFragment" />
        <action
            android:id="@+id/action_planesHomeFragment_to_misPlanesFragment"
            app:destination="@id/misPlanesFragment" />
    </fragment>

    <fragment
        android:id="@+id/planComidaFragment"
        android:name="com.lupefit.feature.planes.ui.PlanComidaFragment"
        android:label="@string/plan_comida"
        tools:layout="@layout/fragment_plan_comida">
        <action
            android:id="@+id/action_planComidaFragment_to_crearPlanComidaFragment"
            app:destination="@id/crearPlanComidaFragment" />
    </fragment>

    <fragment
        android:id="@+id/planEntrenamientoFragment"
        android:name="com.lupefit.feature.planes.ui.PlanEntrenamientoFragment"
        android:label="@string/plan_entrenamiento"
        tools:layout="@layout/fragment_plan_entrenamiento">
        <action
            android:id="@+id/action_planEntrenamientoFragment_to_crearPlanEntrenamientoFragment"
            app:destination="@id/crearPlanEntrenamientoFragment" />
    </fragment>

    <fragment
        android:id="@+id/presupuestoPlanFragment"
        android:name="com.lupefit.feature.planes.ui.PresupuestoPlanFragment"
        android:label="@string/presupuesto_plan"
        tools:layout="@layout/fragment_presupuesto_plan" />

    <fragment
        android:id="@+id/misPlanesFragment"
        android:name="com.lupefit.feature.planes.ui.MisPlanesFragment"
        android:label="@string/mis_planes"
        tools:layout="@layout/fragment_mis_planes" />

    <!-- Placeholder fragments for future implementation -->
    <fragment
        android:id="@+id/crearPlanComidaFragment"
        android:name="com.lupefit.feature.planes.ui.CrearPlanComidaFragment"
        android:label="@string/crear_plan_comida"
        tools:layout="@layout/fragment_crear_plan_comida" />

    <fragment
        android:id="@+id/crearPlanEntrenamientoFragment"
        android:name="com.lupefit.feature.planes.ui.CrearPlanEntrenamientoFragment"
        android:label="@string/crear_plan_entrenamiento"
        tools:layout="@layout/fragment_crear_plan_entrenamiento" />

</navigation>