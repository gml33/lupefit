<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_ejercicio"
    app:startDestination="@id/ejercicioHomeFragment">

    <fragment
        android:id="@+id/ejercicioHomeFragment"
        android:name="com.lupefit.feature.ejercicio.ui.EjercicioHomeFragment"
        android:label="@string/ejercicio_title"
        tools:layout="@layout/fragment_ejercicio_home">
        <action
            android:id="@+id/action_ejercicioHomeFragment_to_buscarEjercicioFragment"
            app:destination="@id/buscarEjercicioFragment" />
        <action
            android:id="@+id/action_ejercicioHomeFragment_to_nuevaRutinaFragment"
            app:destination="@id/nuevaRutinaFragment" />
        <action
            android:id="@+id/action_ejercicioHomeFragment_to_wodTimerFragment"
            app:destination="@id/wodTimerFragment" />
    </fragment>

    <fragment
        android:id="@+id/buscarEjercicioFragment"
        android:name="com.lupefit.feature.ejercicio.ui.BuscarEjercicioFragment"
        android:label="@string/buscar_ejercicio"
        tools:layout="@layout/fragment_buscar_ejercicio" />

    <fragment
        android:id="@+id/nuevaRutinaFragment"
        android:name="com.lupefit.feature.ejercicio.ui.NuevaRutinaFragment"
        android:label="@string/nueva_rutina"
        tools:layout="@layout/fragment_nueva_rutina" />

    <fragment
        android:id="@+id/wodTimerFragment"
        android:name="com.lupefit.feature.ejercicio.ui.WodTimerFragment"
        android:label="@string/wod_timer"
        tools:layout="@layout/fragment_wod_timer" />

    <fragment
        android:id="@+id/rutinaDetalleFragment"
        android:name="com.lupefit.feature.ejercicio.ui.RutinaDetalleFragment"
        android:label="@string/rutina_detalle"
        tools:layout="@layout/fragment_rutina_detalle" />
</navigation>