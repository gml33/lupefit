<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="com.lupefit.feature.configuracion.R" />
                <variable
            name="viewModel"
            type="com.lupefit.feature.configuracion.viewmodel.NotificacionesViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.NotificacionesFragment">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/notificaciones" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notificaciones_generales"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchPush"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_s"
                            android:text="@string/notificaciones_push"
                            android:checked="@{viewModel.pushEnabled}" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchResumenSemanal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_s"
                            android:text="@string/resumen_semanal"
                            android:checked="@{viewModel.resumenSemanal}" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchLogros"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/logros"
                            android:checked="@{viewModel.logros}" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/recordatorios"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="@dimen/spacing_s">

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switchRecordatorioAgua"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/recordatorio_agua"
                                    android:checked="@{viewModel.recordatorioAgua}" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilHoraAgua"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_s"
                                    android:hint="@string/hora_recordatorio"
                                    app:boxBackgroundMode="outline"
                                    app:boxCornerRadiusTopStart="@dimen/corner_small"
                                    app:boxCornerRadiusTopEnd="@dimen/corner_small"
                                    app:boxCornerRadiusBottomStart="@dimen/corner_small"
                                    app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                                    app:endIconDrawable="@drawable/ic_access_time"
                                    android:visibility="@{viewModel.recordatorioAgua ? View.VISIBLE : View.GONE}">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etHoraAgua"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:clickable="true"
                                        android:text="@{viewModel.horaRecordatorioAgua}" />
                                </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="@dimen/spacing_s">

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switchRecordatorioComida"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/recordatorio_comida"
                                    android:checked="@{viewModel.recordatorioComida}" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilHoraComida"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_s"
                                    android:hint="@string/hora_recordatorio"
                                    app:boxBackgroundMode="outline"
                                    app:boxCornerRadiusTopStart="@dimen/corner_small"
                                    app:boxCornerRadiusTopEnd="@dimen/corner_small"
                                    app:boxCornerRadiusBottomStart="@dimen/corner_small"
                                    app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                                    app:endIconDrawable="@drawable/ic_access_time"
                                    android:visibility="@{viewModel.recordatorioComida ? View.VISIBLE : View.GONE}">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etHoraComida"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:clickable="true"
                                        android:text="@{viewModel.horaRecordatorioComida}" />
                                </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchRecordatorioEjercicio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_s"
                            android:text="@string/recordatorio_ejercicio"
                            android:checked="@{viewModel.recordatorioEjercicio}" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchRecordatorioPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/recordatorio_peso"
                            android:checked="@{viewModel.recordatorioPeso}" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
