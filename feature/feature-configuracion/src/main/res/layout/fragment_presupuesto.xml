<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="com.lupefit.feature.configuracion.R" />
                <variable
            name="viewModel"
            type="com.lupefit.feature.configuracion.viewmodel.PresupuestoViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.PresupuestoFragment">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/presupuesto_semanal" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_m">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/meta_semanal"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilMetaSemanal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_m"
                                android:hint="@string/meta"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusTopStart="@dimen/corner_small"
                                app:boxCornerRadiusTopEnd="@dimen/corner_small"
                                app:boxCornerRadiusBottomStart="@dimen/corner_small"
                                app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMetaSemanal"
                                    android:layout_width="120dp"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:text="@{viewModel.metaSemanal}"
                                    android:gravity="end" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressPresupuesto"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginBottom="@dimen/spacing_s"
                            android:progress="@{(int)viewModel.porcentajeGasto}"
                            app:indicatorColor="@{viewModel.estadoColorRes}"
                            app:trackColor="?attr/colorSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_m">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@{@string/gasto_actual(viewModel.gastoActual)}"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{@string/meta(viewModel.metaSemanal)}"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.estadoPresupuesto}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@{viewModel.estadoColorRes}"
                            android:gravity="center"
                            android:layout_marginBottom="@dimen/spacing_m" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_s">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/items_sin_precio"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.valueOf(viewModel.itemsSinPrecio)}"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/status_warning" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/items_sin_precio_desc"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerItemsSinPrecio"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ver_items_sin_precio"
                            app:icon="@drawable/ic_visibility"
                            app:iconGravity="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/historial_presupuesto"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHistorialPresupuesto"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:clipToPadding="false"
                            android:padding="@dimen/spacing_s"
                            tools:listitem="@layout/item_presupuesto_semanal" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
