<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.ConfiguracionHomeFragment">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/configuracion_title" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionCuenta"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/cuenta"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionPerfil"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/perfil"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionMetas"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/metas_personalizadas"
                    app:icon="@drawable/ic_target"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionNotificaciones"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/notificaciones"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionApariencia"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/apariencia"
                    app:icon="@drawable/ic_visibility"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionUnidades"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/unidades"
                    app:icon="@drawable/ic_scale"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionSync"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/sincronizacion"
                    app:icon="@drawable/ic_sync"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionExportar"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/exportar_datos"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionCostos"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/seguimiento_costos"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/optionPresupuesto"
                    style="@style/Widget.LuPeFit.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:gravity="start|center_vertical"
                    android:text="@string/presupuesto_semanal"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="start"
                    app:iconTint="?attr/colorOnSecondaryContainer" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
