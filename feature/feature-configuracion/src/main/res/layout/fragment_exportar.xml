<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <import type="com.lupefit.feature.configuracion.R" />
                <variable
            name="viewModel"
            type="com.lupefit.feature.configuracion.viewmodel.ExportarViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.ExportarFragment">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/exportar_datos" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/formato_exportacion"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <RadioGroup
                            android:id="@+id/rgFormato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:checkedButton="@{viewModel.formato == com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.FormatoExportacion.CSV ? R.id.rbCsv : R.id.rbJson}">

                            <RadioButton
                                android:id="@+id/rbCsv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/csv"
                                android:onClick="@{() -> viewModel.setFormato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.FormatoExportacion.CSV)}" />

                            <RadioButton
                                android:id="@+id/rbJson"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/json"
                                android:onClick="@{() -> viewModel.setFormato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.FormatoExportacion.JSON)}" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/datos_a_exportar"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <RadioGroup
                            android:id="@+id/rgTipoDato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:checkedButton="@{viewModel.tipoDato == com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.TODO ? R.id.rbTodo : (viewModel.tipoDato == com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.DIARIO ? R.id.rbDiario : (viewModel.tipoDato == com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.EJERCICIO ? R.id.rbEjercicio : (viewModel.tipoDato == com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.PROGRESO ? R.id.rbProgreso : (viewModel.tipoDato == com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.AGUA ? R.id.rbAgua : R.id.rbRecetas))))}">

                            <RadioButton
                                android:id="@+id/rbTodo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/todos_los_datos"
                                android:onClick="@{() -> viewModel.setTipoDato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.TODO)}" />

                            <RadioButton
                                android:id="@+id/rbDiario"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/diario_alimentos"
                                android:onClick="@{() -> viewModel.setTipoDato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.DIARIO)}" />

                            <RadioButton
                                android:id="@+id/rbEjercicio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ejercicios"
                                android:onClick="@{() -> viewModel.setTipoDato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.EJERCICIO)}" />

                            <RadioButton
                                android:id="@+id/rbProgreso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/progreso"
                                android:onClick="@{() -> viewModel.setTipoDato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.PROGRESO)}" />

                            <RadioButton
                                android:id="@+id/rbRecetas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/recetas"
                                android:onClick="@{() -> viewModel.setTipoDato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.RECETAS)}" />


                            <RadioButton
                                android:id="@+id/rbAgua"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/lupefit_export_agua"
                                android:onClick="@{() -> viewModel.setTipoDato(com.lupefit.feature.configuracion.viewmodel.ExportarViewModel.TipoDato.AGUA)}" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/corner_large"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/rango_fechas"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/spacing_m">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilFechaInicio"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/spacing_s"
                                android:hint="@string/fecha_inicio"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusTopStart="@dimen/corner_small"
                                app:boxCornerRadiusTopEnd="@dimen/corner_small"
                                app:boxCornerRadiusBottomStart="@dimen/corner_small"
                                app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                                app:endIconDrawable="@drawable/ic_calendar">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etFechaInicio"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:text="@{viewModel.fechaInicio}" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilFechaFin"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_s"
                                android:hint="@string/fecha_fin"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusTopStart="@dimen/corner_small"
                                app:boxCornerRadiusTopEnd="@dimen/corner_small"
                                app:boxCornerRadiusBottomStart="@dimen/corner_small"
                                app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                                app:endIconDrawable="@drawable/ic_calendar">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etFechaFin"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:text="@{viewModel.fechaFin}" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/exportar"
                    android:enabled="@{!viewModel.exportando}"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="start" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:visibility="@{viewModel.exportando ? View.VISIBLE : View.GONE}">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:layout_marginBottom="@dimen/spacing_s" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.progreso}"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:gravity="center" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.archivoGenerado}"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/status_success"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:visibility="@{viewModel.archivoGeneradoVisible ? View.VISIBLE : View.GONE}" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
