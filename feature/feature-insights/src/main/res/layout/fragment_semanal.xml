<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.lupefit.feature.insights.viewmodel.SemanalViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.SemanalFragment">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/resumen_semanal" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/resumen_semanal"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:layout_marginBottom="@dimen/spacing_l" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecargar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/recargar"
                    android:layout_marginBottom="@dimen/spacing_m" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvResumenSemanal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="@{viewModel.cargando ? View.GONE : View.VISIBLE}"
                    tools:listitem="@layout/item_resumen_macro" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="@{viewModel.cargando ? View.VISIBLE : View.GONE}" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/periodo"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:layout_marginBottom="@dimen/spacing_s" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPeriodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    android:singleLine="false"
                    app:chipSpacing="@dimen/spacing_s"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEstaSemana"
                        style="@style/Widget.Material3.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/esta_semana"
                        android:checked="@{viewModel.periodo == `Esta semana`}"
                        android:onClick="@{() -> viewModel.setPeriodo(`Esta semana`)}" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMesPasado"
                        style="@style/Widget.Material3.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mes_pasado"
                        android:checked="@{viewModel.periodo == `Mes pasado`}"
                        android:onClick="@{() -> viewModel.setPeriodo(`Mes pasado`)}" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTrimestre"
                        style="@style/Widget.Material3.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trimestre"
                        android:checked="@{viewModel.periodo == `Trimestre`}"
                        android:onClick="@{() -> viewModel.setPeriodo(`Trimestre`)}" />
                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
