<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.lupefit.feature.insights.viewmodel.PatronesViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.PatronesFragment">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:title="@string/patrones" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_m"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecargar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/recargar"
                    android:layout_marginBottom="@dimen/spacing_m" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="@{viewModel.cargando ? View.VISIBLE : View.GONE}" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_l"
                    app:cardCornerRadius="@dimen/corner_card"
                    app:cardElevation="@dimen/elevation_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patron_principal"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginBottom="@dimen/spacing_s" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvPatronPrincipal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.patronPrincipal}"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="@dimen/spacing_m" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/consistencia_global"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:layout_marginBottom="@dimen/spacing_s" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progressConsistencia"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="@{viewModel.scoreConsistencia}"
                                app:indicatorColor="@color/streak_active"
                                app:trackColor="@color/md_theme_outline"
                                app:trackThickness="8dp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvScoreConsistencia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{viewModel.scoreConsistencia + ` %`}"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorPrimary"
                                android:layout_marginStart="@dimen/spacing_m" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/patrones_detectados"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:layout_marginBottom="@dimen/spacing_s" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPatrones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="@{viewModel.cargando ? View.GONE : View.VISIBLE}"
                    tools:listitem="@layout/item_patron_alimentario" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>