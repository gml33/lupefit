<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_progreso"
    app:startDestination="@id/progresoHomeFragment">

    <fragment
        android:id="@+id/progresoHomeFragment"
        android:name="com.lupefit.feature.progreso.ui.ProgresoHomeFragment"
        android:label="@string/progreso_title"
        tools:layout="@layout/fragment_progreso_home">
        <action
            android:id="@+id/action_progresoHomeFragment_to_pesoFragment"
            app:destination="@id/pesoFragment" />
    </fragment>

    <fragment
        android:id="@+id/pesoFragment"
        android:name="com.lupefit.feature.progreso.ui.PesoFragment"
        android:label="@string/peso"
        tools:layout="@layout/fragment_peso" />
</navigation>
