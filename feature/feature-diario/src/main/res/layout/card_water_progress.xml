<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_card"
        android:layout_marginVertical="@dimen/spacing_sm"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="@dimen/elevation_card"
        app:cardBackgroundColor="?attr/colorSurface"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="@dimen/divider_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hidratacion"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvWaterProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 2500 ml"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/water_primary" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressWater"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_track_thickness"
            android:progress="0"
            android:max="2500"
            android:indeterminate="false"
            app:trackColor="@color/water_track_light"
            app:indicatorColor="@color/water_primary"
            app:trackCornerRadius="@dimen/radius_progress_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_xs">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddWater"
                style="@style/Widget.LuPeFit.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/agregar_vaso"
                android:icon="@drawable/ic_plus"
                app:iconGravity="start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickWater"
                style="@style/Widget.LuPeFit.Button.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/vaso_250ml"
                app:iconGravity="start" />
        </LinearLayout>
    </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>