<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.lupefit.feature.diario.viewmodel.DiarioCrearAlimentoViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.DiarioCrearAlimentoFragment">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:title="@string/crear_alimento"
                app:navigationIcon="@drawable/ic_chevron_left"
                app:menu="@menu/menu_crear_alimento" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <!-- Nombre -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/crear_nombre"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="@dimen/corner_small"
                    app:boxCornerRadiusTopEnd="@dimen/corner_small"
                    app:boxCornerRadiusBottomStart="@dimen/corner_small"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Marca -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMarca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="@string/crear_marca"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="@dimen/corner_small"
                    app:boxCornerRadiusTopEnd="@dimen/corner_small"
                    app:boxCornerRadiusBottomStart="@dimen/corner_small"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMarca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Código de barras (opcional) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="@string/crear_codigo_barras"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="@dimen/corner_small"
                    app:boxCornerRadiusTopEnd="@dimen/corner_small"
                    app:boxCornerRadiusBottomStart="@dimen/corner_small"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_small"
                    app:endIconDrawable="@drawable/ic_scan"
                    app:endIconContentDescription="@string/crear_escanear_codigo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sección Macros por 100g -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:text="@string/crear_macros_100g"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_m"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:hint="@string/crear_kcal"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/corner_small"
                        app:boxCornerRadiusTopEnd="@dimen/corner_small"
                        app:boxCornerRadiusBottomStart="@dimen/corner_small"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKcal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="@{String.valueOf(viewModel.kcal)}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:hint="@string/crear_proteinas"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/corner_small"
                        app:boxCornerRadiusTopEnd="@dimen/corner_small"
                        app:boxCornerRadiusBottomStart="@dimen/corner_small"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProtein"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="@{String.valueOf(viewModel.protein)}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:hint="@string/crear_carbohidratos"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/corner_small"
                        app:boxCornerRadiusTopEnd="@dimen/corner_small"
                        app:boxCornerRadiusBottomStart="@dimen/corner_small"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCarbs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="@{String.valueOf(viewModel.carbs)}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:hint="@string/crear_grasas"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/corner_small"
                        app:boxCornerRadiusTopEnd="@dimen/corner_small"
                        app:boxCornerRadiusBottomStart="@dimen/corner_small"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="@{String.valueOf(viewModel.fat)}" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Porción por defecto -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPorcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="@string/crear_porcion_defecto"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="@dimen/corner_small"
                    app:boxCornerRadiusTopEnd="@dimen/corner_small"
                    app:boxCornerRadiusBottomStart="@dimen/corner_small"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPorcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="@{String.valueOf(viewModel.defaultServingGrams)}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Es alimento fresco -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFreshFood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/crear_es_fresco"
                    android:checked="@={viewModel.isFreshFood}" />

                <!-- Botón guardar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:layout_marginBottom="@dimen/spacing_l"
                    android:text="@string/crear_guardar"
                    android:onClick="@{() -> viewModel.saveFood()}" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>