<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="escaneo"
            type="com.lupefit.core.domain.model.EscaneoEntry" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_s"
        app:cardCornerRadius="@dimen/corner_small"
        app:cardElevation="@dimen/elevation_card"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m">

            <!-- Icon based on type -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/spacing_m"
                app:tipoIcon="@{escaneo.tipo}"
                android:contentDescription="@{escaneo.tipo}" />

            <!-- Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{escaneo.productoNombre}"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Coca Cola Zero" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Type Chip -->
                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_s"
                        app:tipoText="@{escaneo.tipo}"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        app:chipCornerRadius="@dimen/corner_small"
                        tools:text="Código de barras" />

                    <!-- Date -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_m"
                        android:text="@{escaneo.fecha}"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="@dimen/spacing_xs"
                        tools:text="21/11/2026" />

                    <!-- Added indicator -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:agregadoText="@{escaneo.agregadoAlDiario}"
                        app:agregadoColor="@{escaneo.agregadoAlDiario}"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        tools:text="Agregado al diario" />
                </LinearLayout>
            </LinearLayout>

            <!-- Arrow -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>