<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="macro"
            type="com.lupefit.feature.nutricion.model.MacroDetail" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_s"
        app:cardCornerRadius="@dimen/corner_small"
        app:cardElevation="@dimen/elevation_card"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m">

                <!-- Icon -->
                <View
                    android:id="@+id/vColorBar"
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_m"
                    android:background="@{macro.color}" />

                <!-- Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMacroName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{macro.name}"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMacroDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@{macro.description}"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Values -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:paddingStart="@dimen/spacing_m">

                    <TextView
                        android:id="@+id/tvMacroValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{macro.value}"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@{macro.color}"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMacroUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{macro.unit}"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvMacroPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@{macro.percentage}"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>