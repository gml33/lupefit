<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:padding="@dimen/spacing_m"
        tools:context=".ui.main.MasBottomSheet">

        <!-- Drag handle -->
        <View
            android:layout_width="@dimen/sheet_drag_handle_width"
            android:layout_height="@dimen/sheet_drag_handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="?attr/colorOutline"
            android:elevation="@dimen/elevation_sheet_handle" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mas"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/spacing_m"
            android:gravity="center" />

        <!-- Options list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_mas_option" />
    </LinearLayout>
</layout>