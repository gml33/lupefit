<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/diarioHomeFragment">

    <!-- Include feature navigation graphs -->
    <include app:graph="@navigation/nav_diario" />
    <include app:graph="@navigation/nav_ejercicio" />
    <include app:graph="@navigation/nav_nutricion" />
    <include app:graph="@navigation/nav_progreso" />
    <include app:graph="@navigation/nav_planes" />

    <!-- Global actions to switch between features (use each feature's home fragment) -->
    <action
        android:id="@+id/action_global_diario"
        app:destination="@id/diarioHomeFragment"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_global_ejercicio"
        app:destination="@id/ejercicioHomeFragment"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_global_nutricion"
        app:destination="@id/nutricionHomeFragment"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_global_progreso"
        app:destination="@id/progresoHomeFragment"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_global_mas"
        app:destination="@id/planesHomeFragment"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />
</navigation>